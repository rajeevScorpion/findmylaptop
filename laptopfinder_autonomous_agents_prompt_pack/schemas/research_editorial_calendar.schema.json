{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaptopFinder Research Editorial Calendar",
  "type": "object",
  "properties": {
    "calendarId": { "type": "string" },
    "name": { "type": "string", "default": "Default Weekly Research Calendar" },
    "enabled": { "type": "boolean", "default": false },
    "timezone": { "type": "string", "default": "Asia/Kolkata" },
    "globalMode": {
      "type": "string",
      "enum": ["draft_only", "approval_required", "auto_schedule", "controlled_auto_publish"],
      "default": "draft_only"
    },
    "globalMaxPostsPerDay": { "type": "integer", "minimum": 0, "default": 2 },
    "globalMaxPostsPerWeek": { "type": "integer", "minimum": 0, "default": 7 },
    "days": {
      "type": "array",
      "items": { "$ref": "#/$defs/calendarDay" },
      "minItems": 1
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["name", "enabled", "timezone", "days"],
  "$defs": {
    "calendarDay": {
      "type": "object",
      "properties": {
        "dayOfWeek": {
          "type": "string",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "enabled": { "type": "boolean", "default": true },
        "runTime": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$", "default": "09:00" },
        "themeName": { "type": "string" },
        "themeDescription": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" }, "default": [] },
        "targetAudience": { "type": "array", "items": { "type": "string" }, "default": [] },
        "allowedContentTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["news", "software-guide", "buying-guide", "comparison", "deal-roundup", "trust-education", "weekly-roundup", "evergreen"]
          },
          "default": ["evergreen"]
        },
        "preferredPersonas": { "type": "array", "items": { "type": "string" }, "default": [] },
        "sourcePriority": { "type": "array", "items": { "type": "string" }, "default": [] },
        "postTarget": { "$ref": "#/$defs/postTarget" },
        "modeOverride": {
          "type": "string",
          "enum": ["inherit", "draft_only", "approval_required", "auto_schedule", "controlled_auto_publish"],
          "default": "inherit"
        },
        "affiliateInsertionMode": {
          "type": "string",
          "enum": ["none", "contextual_only", "product_cards", "comparison_links"],
          "default": "contextual_only"
        },
        "maxProductCardsPerPost": { "type": "integer", "minimum": 0, "maximum": 12, "default": 4 },
        "minResearchConfidenceScore": { "type": "integer", "minimum": 0, "maximum": 100, "default": 70 },
        "minBlogQualityScore": { "type": "integer", "minimum": 0, "maximum": 100, "default": 75 },
        "researchExpiryHours": { "type": "integer", "minimum": 1, "default": 168 }
      },
      "required": ["dayOfWeek", "themeName", "postTarget"]
    },
    "postTarget": {
      "type": "object",
      "properties": {
        "minPosts": { "type": "integer", "minimum": 0, "default": 0 },
        "targetPosts": { "type": "integer", "minimum": 0, "default": 1 },
        "maxPosts": { "type": "integer", "minimum": 0, "default": 2 },
        "allowCarryForward": { "type": "boolean", "default": true },
        "carryForwardLimitDays": { "type": "integer", "minimum": 0, "default": 7 }
      },
      "required": ["targetPosts", "maxPosts"]
    }
  }
}
