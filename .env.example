NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Current model routing. Override only after testing the replacement model.
LLM_MODEL_RESEARCH=gpt-5.6-terra
LLM_MODEL_BLOGGING=gpt-5.6-luna
LLM_MODEL_CHIP=gpt-5.6-luna
LLM_MODEL_EXTRACTION=gpt-5.6-luna
LLM_MODEL_TRANSCRIPTION=gpt-4o-mini-transcribe
# Optional comma-separated domains approved for Research Agent web search.
# Official manufacturer/platform domains remain the fail-closed fallback.
RESEARCH_ALLOWED_DOMAINS=
ADMIN_EMAILS=your-email@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel sends CRON_SECRET automatically; AGENT_CRON_SECRET also supports
# non-Vercel schedulers. If both are set, either valid bearer token is accepted.
CRON_SECRET=
AGENT_CRON_SECRET=

# Amazon Creators API (EU region — covers amazon.in)
# Get credentials from Associates Central → Tools → Creators API
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=your-tag-21
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_CREATORS_ENABLED=true

# Flipkart stays disabled until current Affiliate API access is confirmed.
FLIPKART_AFFILIATE_ENABLED=false
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
